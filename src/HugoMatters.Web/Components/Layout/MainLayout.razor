@inherits LayoutComponentBase

<div class="flex min-h-screen">
    <aside class="w-64 shrink-0 border-r border-slate-200 bg-white">
        <NavMenu />
    </aside>

    <div class="flex flex-1 flex-col">
        <header class="flex h-14 items-center justify-end border-b border-slate-200 bg-white px-6">
            <span class="text-sm text-slate-500">Hugo Matters CMS</span>
        </header>

        <main class="flex-1 p-6">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" class="fixed bottom-0 left-0 right-0 z-50 hidden border-t border-amber-200 bg-amber-50 px-4 py-3 text-amber-900 shadow-lg">
  An unhandled error has occurred.
    <a href="" class="ml-2 font-medium underline">Reload</a>
    <button type="button" class="dismiss absolute right-3 top-2 text-amber-700">✕</button>
</div>
