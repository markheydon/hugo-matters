@inherits LayoutComponentBase
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery

<div class="flex min-h-screen">
    <aside class="w-64 shrink-0 border-r border-slate-200 bg-white">
        <NavMenu />
    </aside>

    <div class="flex flex-1 flex-col">
        <header class="flex h-14 items-center justify-end gap-4 border-b border-slate-200 bg-white px-6">
            <AuthorizeView>
                <Authorized>
                    @if (_antiforgeryTokens is not null)
                    {
                        <form method="post" action="/auth/sign-out">
                            <input type="hidden" name="@_antiforgeryTokens.FormFieldName" value="@_antiforgeryTokens.RequestToken" />
                            <button type="submit" class="text-sm font-medium text-slate-600 hover:text-slate-900">Sign out</button>
                        </form>
                    }
                </Authorized>
            </AuthorizeView>
            <span class="text-sm text-slate-500">Hugo Matters CMS</span>
        </header>

        <main class="flex-1 p-6">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" class="fixed bottom-0 left-0 right-0 z-50 hidden border-t border-amber-200 bg-amber-50 px-4 py-3 text-amber-900 shadow-lg">
  An unhandled error has occurred.
    <a href="" class="ml-2 font-medium underline">Reload</a>
    <button type="button" class="dismiss absolute right-3 top-2 text-amber-700">✕</button>
</div>

@code {
    private AntiforgeryTokenSet? _antiforgeryTokens;

    protected override void OnInitialized()
    {
        if (HttpContextAccessor.HttpContext is not null)
        {
            _antiforgeryTokens = Antiforgery.GetAndStoreTokens(HttpContextAccessor.HttpContext);
        }
    }
}
