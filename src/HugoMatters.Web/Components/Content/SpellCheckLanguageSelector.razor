@namespace HugoMatters.Web.Components.Content

<div class="space-y-1">
    <Select
        Label="Spell-check language"
        Value="@SelectedLanguage"
        ValueChanged="OnLanguageChanged"
        Options="@LanguageOptions" />
    <p class="text-xs text-slate-500">
        Uses your browser’s built-in spellchecker. Squiggles appear only if that language dictionary is installed on this device.
    </p>
</div>

@code {
    [Parameter]
    public string SelectedLanguage { get; set; } = "en-GB";

    [Parameter]
    public EventCallback<string> SelectedLanguageChanged { get; set; }

    private static readonly IReadOnlyList<Select.SelectOption> LanguageOptions = [
        new("en-GB", "English (UK)"),
        new("en-US", "English (US)"),
        new("de", "German"),
        new("fr", "French"),
        new("es", "Spanish"),
        new("it", "Italian"),
        new("pt", "Portuguese"),
        new("nl", "Dutch"),
        new("sv", "Swedish"),
        new("da", "Danish"),
        new("no", "Norwegian"),
        new("fi", "Finnish"),
        new("pl", "Polish"),
    ];

    private async Task OnLanguageChanged(string? value)
    {
        if (value is not null)
        {
            SelectedLanguage = value;
            await SelectedLanguageChanged.InvokeAsync(value);
        }
    }
}
