@page "/content/{*contentPath}"
@rendermode InteractiveServer
@inject HugoMattersApiClient Api
@inject NavigationManager Navigation

<PageTitle>Edit Content</PageTitle>

@if (loading)
{
    <div class="flex items-center gap-2 text-slate-500">
        <Icon Name="loader" CssClass="animate-spin" />
        <span>Loading editor…</span>
    </div>
}
else if (item is null)
{
    <div class="rounded-xl border border-slate-200 bg-white p-8 text-center">
        <p class="text-sm text-slate-600">Content not found.</p>
        <div class="mt-4">
            <Button Variant="Button.ButtonVariant.Secondary" IconName="arrow-left" OnClick="@(() => Navigation.NavigateTo("/content"))">
                Back to content list
            </Button>
        </div>
    </div>
}
else
{
    <div>
        <div class="flex items-center justify-between">
            <div>
                <Button Variant="Button.ButtonVariant.Ghost" IconName="arrow-left" OnClick="@(() => Navigation.NavigateTo("/content"))">
                    Back
                </Button>
                <h1 class="mt-2 text-2xl font-bold text-slate-900">Edit content</h1>
                <p class="mt-1 font-mono text-sm text-slate-500">@item.Path</p>
            </div>
            <div class="flex gap-2">
                <Button Variant="Button.ButtonVariant.Danger" IconName="trash" OnClick="DeleteContent" Loading="@deleting">
                    Delete
                </Button>
                <Button IconName="save" OnClick="SaveContent" Loading="@saving">
                    Save locally
                </Button>
            </div>
        </div>

        <Banner
            Variant="@bannerVariant"
            Message="@bannerMessage"
            IsVisible="@(bannerMessage is not null)"
            IsVisibleChanged="@((bool v) => { if (!v) bannerMessage = null; })" />

        <div class="mt-4 flex items-center justify-between">
            <SpellCheckLanguageSelector SelectedLanguage="@spellCheckLanguage" SelectedLanguageChanged="OnSpellCheckLanguageChanged" />
            @if (item.HasUnsavedLocalEdits)
            {
                <span class="text-sm text-amber-600">Unsaved local edits</span>
            }
        </div>

        <div class="mt-6 grid gap-6 lg:grid-cols-2">
            <div class="space-y-6">
                <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                    <h2 class="text-sm font-semibold text-slate-900">Frontmatter</h2>
                    <div class="mt-4">
                        <ThemeFieldEditor
                            Fields="@themeFields"
                            FrontMatter="@frontMatter"
                            FrontMatterChanged="OnFrontMatterChanged"
                            SpellCheckLanguage="@spellCheckLanguage" />
                    </div>
                </div>

                <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                    <h2 class="text-sm font-semibold text-slate-900">Body</h2>
                    <div class="mt-4">
                        <TextField
                            Multiline="true"
                            Rows="16"
                            Value="@body"
                            ValueChanged="@OnBodyChanged"
                            SpellCheck="true"
                            Lang="@spellCheckLanguage"
                            Placeholder="Write your Markdown content…" />
                    </div>
                </div>
            </div>

            <div>
                <EditorPreviewPane Body="@body" FrontMatter="@frontMatter" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string? ContentPath { get; set; }

    private ContentItemDto? item;
    private List<FieldDefinitionDto> themeFields = [];
    private Dictionary<string, object?> frontMatter = new();
    private string body = "";
    private string spellCheckLanguage = "en";
    private bool loading = true;
    private bool saving;
    private bool deleting;
    private string? bannerMessage;
    private Banner.BannerVariant bannerVariant = Banner.BannerVariant.Info;

    protected override async Task OnParametersSetAsync()
    {
        if (ContentPath is not null)
        {
            await LoadContent();
        }
    }

    private async Task LoadContent()
    {
        loading = true;
        bannerMessage = null;

        try
        {
            item = await Api.GetContentAsync(ContentPath!);
            if (item is null)
            {
                return;
            }

            frontMatter = new Dictionary<string, object?>(item.FrontMatter);
            body = item.Body;

            var site = await Api.GetConnectionAsync();
            if (site is not null)
            {
                var pack = await Api.GetThemePackAsync(site.ThemePackId);
                if (pack is not null)
                {
                    var contentType = pack.ContentTypes.FirstOrDefault(ct => ct.Id == item.ContentType);
                    themeFields = contentType?.Fields ?? [];
                }
            }
        }
        catch (ApiException ex)
        {
            ShowBanner(ex.Message, Banner.BannerVariant.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnFrontMatterChanged(Dictionary<string, object?> updated)
    {
        frontMatter = updated;
        await Task.CompletedTask;
    }

    private async Task OnBodyChanged(string? value)
    {
        body = value ?? "";
        await Task.CompletedTask;
    }

    private async Task OnSpellCheckLanguageChanged(string language)
    {
        spellCheckLanguage = language;
        await Task.CompletedTask;
    }

    private async Task SaveContent()
    {
        if (item is null)
        {
            return;
        }

        saving = true;

        try
        {
            item = await Api.UpdateContentAsync(item.Path, new ContentItemWrite
            {
                FrontMatter = frontMatter,
                Body = body,
            });

            ShowBanner("Content saved to session buffer.", Banner.BannerVariant.Success);
        }
        catch (ApiException ex)
        {
            ShowBanner(ex.Message, Banner.BannerVariant.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteContent()
    {
        if (item is null)
        {
            return;
        }

        deleting = true;

        try
        {
            await Api.DeleteContentAsync(item.Path);
            Navigation.NavigateTo("/content");
        }
        catch (ApiException ex)
        {
            ShowBanner(ex.Message, Banner.BannerVariant.Error);
        }
        finally
        {
            deleting = false;
        }
    }

    private void ShowBanner(string message, Banner.BannerVariant variant)
    {
        bannerMessage = message;
        bannerVariant = variant;
    }
}
