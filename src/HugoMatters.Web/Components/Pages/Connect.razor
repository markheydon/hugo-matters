@page "/connect"
@rendermode InteractiveServer
@inject HugoMattersApiClient Api
@inject NavigationManager Navigation

<PageTitle>Connect Repository</PageTitle>

<div class="max-w-2xl">
    <h1 class="text-2xl font-bold text-slate-900">Connect your Hugo site</h1>
    <p class="mt-2 text-sm text-slate-600">
        Authorize Hugo Matters via the GitHub App to connect your Hugo repository.
        Only the repository you select will be accessible.
    </p>

    <Banner
        Variant="Banner.BannerVariant.Error"
        Title="Connection failed"
        Message="@errorMessage"
        IsVisible="@(errorMessage is not null)"
        IsVisibleChanged="@((bool v) => { if (!v) errorMessage = null; })" />

    <div class="mt-8 space-y-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center gap-3 text-brand-700">
            <Icon Name="github" Size="24" />
            <h2 class="text-lg font-semibold">GitHub repository</h2>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <TextField Label="Owner" Placeholder="github-username" Value="@owner" ValueChanged="@(v => owner = v ?? "")" Required="true" />
            <TextField Label="Repository" Placeholder="my-hugo-site" Value="@repo" ValueChanged="@(v => repo = v ?? "")" Required="true" />
        </div>

        <TextField
            Label="Installation ID (optional)"
            Hint="Provide if you already installed the GitHub App and know the installation ID."
            Placeholder="12345678"
            Value="@installationIdText"
            ValueChanged="@(v => installationIdText = v ?? "")" />

        <div class="flex gap-3">
            <Button IconName="link" OnClick="ConnectRepository" Loading="@loading">
                Connect repository
            </Button>
            <Button Variant="Button.ButtonVariant.Secondary" OnClick="@(() => Navigation.NavigateTo("/"))">
                Cancel
            </Button>
        </div>
    </div>

    <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
        <p class="font-medium text-slate-700">Before connecting</p>
        <ol class="mt-2 list-decimal list-inside space-y-1">
            <li>Create a GitHub App with Contents and Pull Request read/write permissions.</li>
            <li>Install the app on your account and grant access to your Hugo site repository.</li>
            <li>Configure App credentials via <code>aspire secret set</code> on AppHost (see github-app-setup.md).</li>
        </ol>
    </div>
</div>

@code {
    private string owner = "";
    private string repo = "";
    private string installationIdText = "";
    private bool loading;
    private string? errorMessage;

    private async Task ConnectRepository()
    {
        if (string.IsNullOrWhiteSpace(owner) || string.IsNullOrWhiteSpace(repo))
        {
            errorMessage = "Owner and repository are required.";
            return;
        }

        loading = true;
        errorMessage = null;

        try
        {
            long? installationId = null;
            if (!string.IsNullOrWhiteSpace(installationIdText) && long.TryParse(installationIdText, out var parsed))
            {
                installationId = parsed;
            }

            var response = await Api.AuthorizeAsync(new AuthorizeRequest
            {
                Owner = owner.Trim(),
                Repo = repo.Trim(),
                InstallationId = installationId,
            });

            if (response.Status == "redirect" && response.RedirectUrl is not null)
            {
                Navigation.NavigateTo(response.RedirectUrl, forceLoad: true);
                return;
            }

            Navigation.NavigateTo("/");
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
