@page "/welcome"
@inherits DeferredLoadPageBase
@layout LandingLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode AppRenderMode.Interactive
@using HugoMatters.Web.Authentication
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Welcome — Hugo Matters</PageTitle>

<div class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm text-center">
    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
        <Icon Name="book-open" Size="28" />
    </div>
    <h1 class="mt-4 text-2xl font-bold text-slate-900">Hugo Matters</h1>
    <p class="mt-2 text-sm text-slate-600">
        Local-first CMS for your Hugo site on GitHub.
    </p>
    <p class="mt-4 text-sm text-slate-600">
        Sign in with your GitHub account to connect your Hugo repository and start editing.
    </p>
    <div class="mt-6">
        <a href="@_signInUrl" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-brand-700">
            <Icon Name="github" Size="18" />
            Sign in with GitHub
        </a>
    </div>
</div>

@code {
    private string _signInUrl = "/auth/sign-in";

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;

    protected override async Task LoadPageAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var returnUrl = GitHubAuthReturnUrl.GetRequestedReturnUrl(uri);
        _signInUrl = QueryHelpers.AddQueryString("/auth/sign-in", new Dictionary<string, string?> { ["returnUrl"] = returnUrl });

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync().ConfigureAwait(false);
        if (authenticationState.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo(returnUrl);
        }
    }
}
