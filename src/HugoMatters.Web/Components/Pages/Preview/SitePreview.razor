@page "/preview"
@inherits DeferredLoadPageBase
@implements IAsyncDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode AppRenderMode.Interactive
@inject HugoMattersApiClient Api

<PageTitle>Site Preview</PageTitle>

<div class="max-w-3xl">
    <h1 class="text-2xl font-bold text-slate-900">Site preview</h1>
    <p class="mt-1 text-sm text-slate-600">
        Start a real Hugo preview from saved session content. Unsaved buffer changes are not included.
    </p>

    <Banner
        Variant="@bannerVariant"
        Message="@bannerMessage"
        IsVisible="@(bannerMessage is not null)"
        IsVisibleChanged="@((bool v) => { if (!v) bannerMessage = null; })" />

    @if (loading)
    {
        <div class="mt-8 flex items-center gap-2 text-slate-500">
            <Icon Name="loader" CssClass="animate-spin" />
            <span>Loading preview status…</span>
        </div>
    }
    else if (starting && progress is not null)
    {
        <div class="mt-8">
            <ActionProgressPanel
                Title="Starting site preview"
                Message="@progress.Message"
                Percent="@progress.Percent"
                Hint="Downloads the saved branch snapshot and starts a local Hugo container." />
        </div>
    }
    else
    {
        <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <h2 class="text-lg font-semibold text-slate-900">Preview status</h2>
                <span class="@GetStatusClasses(preview?.Status ?? "Stopped")">
                    @(preview?.Status ?? "Stopped")
                </span>
            </div>

            @if (preview is not null)
            {
                <dl class="mt-6 grid gap-4 sm:grid-cols-2">
                    @if (preview.BaseUrl is not null)
                    {
                        <div>
                            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Preview URL</dt>
                            <dd class="mt-1 text-sm">
                                <a href="@preview.BaseUrl" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-brand-600 hover:underline">
                                    @preview.BaseUrl
                                    <Icon Name="external-link" Size="14" />
                                </a>
                            </dd>
                        </div>
                    }
                    @if (preview.SourceRef is not null)
                    {
                        <div>
                            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Source commit</dt>
                            <dd class="mt-1 font-mono text-sm text-slate-900">@preview.SourceRef[..Math.Min(7, preview.SourceRef.Length)]</dd>
                        </div>
                    }
                    @if (preview.ErrorMessage is not null)
                    {
                        <div class="sm:col-span-2">
                            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Error</dt>
                            <dd class="mt-1 text-sm text-red-600">@preview.ErrorMessage</dd>
                        </div>
                    }
                </dl>
            }

            <div class="mt-6 flex flex-wrap gap-3">
                @if (preview?.Status is "Running" or "Starting")
                {
                    <Button Variant="Button.ButtonVariant.Danger" IconName="square" OnClick="StopPreview" Loading="@stopping">
                        Stop preview
                    </Button>
                    @if (preview.BaseUrl is not null)
                    {
                        <a href="@preview.BaseUrl" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
                            <Icon Name="external-link" Size="16" />
                            Open preview
                        </a>
                    }
                }
                else
                {
                    <Button IconName="play" OnClick="StartPreview" Disabled="@starting">
                        Start preview
                    </Button>
                }
                <Button Variant="Button.ButtonVariant.Secondary" IconName="loader" OnClick="RefreshStatus" Loading="@refreshing" Disabled="@starting">
                    Refresh status
                </Button>
            </div>
        </div>
    }
</div>

@code {
    private static readonly string[] StartProgressMessages =
    [
        "Resolving session branch…",
        "Downloading site snapshot…",
        "Preparing preview workspace…",
        "Starting Hugo container…",
        "Waiting for preview to become ready…",
    ];

    private SitePreviewDto? preview;
    private bool loading = true;
    private bool starting;
    private bool stopping;
    private bool refreshing;
    private string? bannerMessage;
    private Banner.BannerVariant bannerVariant = Banner.BannerVariant.Info;
    private SteppedProgressRunner? progress;

    protected override Task LoadPageAsync() => RefreshStatus();

    private async Task RefreshStatus()
    {
        refreshing = true;
        loading = preview is null;

        try
        {
            preview = await Api.GetSitePreviewAsync();
        }
        catch (ApiException ex)
        {
            ShowBanner(ex.Message, Banner.BannerVariant.Error);
        }
        finally
        {
            loading = false;
            refreshing = false;
        }
    }

    private async Task StartPreview()
    {
        starting = true;
        bannerMessage = null;
        progress = new SteppedProgressRunner(
            StartProgressMessages,
            () => InvokeAsync(StateHasChanged));

        try
        {
            // Clear a stuck Starting/Failed preview so start can run again.
            if (preview?.Status is "Starting" or "Failed")
            {
                try
                {
                    await Api.StopSitePreviewAsync();
                    preview = null;
                }
                catch (ApiException)
                {
                    // Continue; start may still succeed if the API treats the existing preview as Failed.
                }
            }

            preview = await progress.RunAsync(
                () => Api.StartSitePreviewAsync(),
                "Preview ready.",
                stepDelayMs: 1100,
                completedHoldMs: 200);

            if (preview.Status is "Starting")
            {
                preview = await WaitForPreviewReadyAsync(preview);
            }

            if (preview.Status is "Failed")
            {
                ShowBanner(
                    preview.ErrorMessage ?? "Site preview failed to start.",
                    Banner.BannerVariant.Error);
            }
            else if (preview.Status is "Running")
            {
                ShowBanner("Site preview started.", Banner.BannerVariant.Success);
            }
            else
            {
                ShowBanner($"Preview status: {preview.Status}.", Banner.BannerVariant.Info);
            }
        }
        catch (OperationCanceledException)
        {
            // HttpClient resilience/timeouts surface as cancellation; poll for the result instead of crashing Blazor.
            ShowBanner("Preview start is still running; checking status…", Banner.BannerVariant.Info);
            try
            {
                preview = await WaitForPreviewReadyAsync(preview ?? new SitePreviewDto { Status = "Starting" });
                if (preview.Status is "Running")
                {
                    ShowBanner("Site preview started.", Banner.BannerVariant.Success);
                }
                else if (preview.Status is "Failed")
                {
                    ShowBanner(preview.ErrorMessage ?? "Site preview failed to start.", Banner.BannerVariant.Error);
                }
            }
            catch (ApiException ex)
            {
                ShowBanner(ex.Message, Banner.BannerVariant.Error);
            }
        }
        catch (ApiException ex)
        {
            ShowBanner(ex.Message, Banner.BannerVariant.Error);
            try
            {
                preview = await Api.GetSitePreviewAsync();
            }
            catch (ApiException)
            {
                // Keep prior preview state if refresh fails.
            }
        }
        catch (Exception ex)
        {
            ShowBanner($"Site preview failed: {ex.Message}", Banner.BannerVariant.Error);
        }
        finally
        {
            await progress.DisposeAsync();
            progress = null;
            starting = false;
        }
    }

    private async Task<SitePreviewDto> WaitForPreviewReadyAsync(SitePreviewDto current)
    {
        for (var attempt = 0; attempt < 90; attempt++)
        {
            await Task.Delay(TimeSpan.FromSeconds(2));
            try
            {
                var latest = await Api.GetSitePreviewAsync();
                if (latest is null)
                {
                    return current;
                }

                current = latest;
                if (current.Status is not "Starting")
                {
                    return current;
                }
            }
            catch (ApiException)
            {
                // Keep polling through transient API errors while Hugo boots.
            }
        }

        return current;
    }

    private async Task StopPreview()
    {
        stopping = true;
        bannerMessage = null;

        try
        {
            await Api.StopSitePreviewAsync();
            preview = null;
            ShowBanner("Site preview stopped.", Banner.BannerVariant.Success);
        }
        catch (ApiException ex)
        {
            ShowBanner(ex.Message, Banner.BannerVariant.Error);
        }
        finally
        {
            stopping = false;
        }
    }

    private void ShowBanner(string message, Banner.BannerVariant variant)
    {
        bannerMessage = message;
        bannerVariant = variant;
    }

    private static string GetStatusClasses(string status)
    {
        var baseClasses = "inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium";
        return baseClasses + " " + (status switch
        {
            "Running" => "bg-green-100 text-green-800",
            "Starting" => "bg-blue-100 text-blue-800",
            "Failed" => "bg-red-100 text-red-800",
            _ => "bg-slate-100 text-slate-600",
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (progress is not null)
        {
            await progress.DisposeAsync();
            progress = null;
        }
    }
}
