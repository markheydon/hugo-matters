@namespace HugoMatters.Web.Components.Shared

<div class="space-y-1">
    @if (Label is not null)
    {
        <label class="block text-sm font-medium text-slate-700" for="@Id">
            @Label
            @if (Required)
            {
                <span class="text-red-500">*</span>
            }
        </label>
    }
    <select
        id="@Id"
        class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 disabled:bg-slate-100"
        disabled="@Disabled"
        @bind="Value"
        @bind:after="OnValueChanged">
        @if (Placeholder is not null)
        {
            <option value="">@Placeholder</option>
        }
        @foreach (var option in Options)
        {
            <option value="@option.Value">@option.Label</option>
        }
    </select>
    @if (Error is not null)
    {
        <p class="text-sm text-red-600">@Error</p>
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = Guid.NewGuid().ToString("N");

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public IReadOnlyList<SelectOption> Options { get; set; } = [];

    private async Task OnValueChanged()
    {
        await ValueChanged.InvokeAsync(Value);
    }

    public sealed record SelectOption(string Value, string Label);
}
