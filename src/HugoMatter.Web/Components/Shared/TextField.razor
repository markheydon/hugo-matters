@namespace HugoMatter.Web.Components.Shared

<div class="space-y-1">
    @if (Label is not null)
    {
        <label class="block text-sm font-medium text-slate-700" for="@Id">
            @Label
            @if (Required)
            {
                <span class="text-red-500">*</span>
            }
        </label>
    }
    @if (Multiline)
    {
        <textarea
            id="@Id"
            class="@InputClasses"
            rows="@Rows"
            placeholder="@Placeholder"
            disabled="@Disabled"
            spellcheck="@SpellCheck"
            lang="@Lang"
            value="@Value"
            @oninput="HandleInput"></textarea>
    }
    else
    {
        <input
            id="@Id"
            type="@InputType"
            class="@InputClasses"
            placeholder="@Placeholder"
            disabled="@Disabled"
            spellcheck="@SpellCheck"
            lang="@Lang"
            value="@Value"
            @oninput="HandleInput" />
    }
    @if (Error is not null)
    {
        <p class="text-sm text-red-600">@Error</p>
    }
    @if (Hint is not null)
    {
        <p class="text-sm text-slate-500">@Hint</p>
    }
</div>

@code {
  private static readonly string InputClasses = "block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 disabled:bg-slate-100";

    [Parameter]
    public string Id { get; set; } = Guid.NewGuid().ToString("N");

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Multiline { get; set; }

    [Parameter]
    public int Rows { get; set; } = 4;

    [Parameter]
    public string InputType { get; set; } = "text";

    [Parameter]
    public bool SpellCheck { get; set; } = true;

    [Parameter]
    public string? Lang { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }
}
