@namespace HugoMatter.Web.Components.Shared

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="fixed inset-0 bg-slate-900/50" @onclick="Close"></div>
        <div class="relative z-10 w-full max-w-lg rounded-xl bg-white shadow-xl">
            <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
                <h2 class="text-lg font-semibold text-slate-900">@Title</h2>
                <button type="button" class="rounded-lg p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-600" @onclick="Close">
                    <Icon Name="x" Size="20" />
                </button>
            </div>
            <div class="px-6 py-4">
                @ChildContent
            </div>
            @if (Footer is not null)
            {
                <div class="flex justify-end gap-3 border-t border-slate-200 px-6 py-4">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
