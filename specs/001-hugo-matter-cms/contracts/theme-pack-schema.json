{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hugo-matter.local/contracts/theme-pack-schema.json",
  "title": "HugoMatterThemePack",
  "type": "object",
  "required": ["id", "version", "displayName", "contentTypes"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Stable pack identifier (e.g. hugo-profile)"
    },
    "version": {
      "type": "string",
      "description": "SemVer of the pack definition"
    },
    "displayName": {
      "type": "string"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "themeNames": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Hugo theme names that identify this pack"
        },
        "requiredFiles": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Repo-relative paths that suggest compatibility"
        }
      }
    },
    "contentTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contentType" }
    },
    "siteConfigFields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" },
      "description": "Minimal site configuration fields for day-one usefulness"
    },
    "pathConventions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postsDirectory": { "type": "string" },
        "pagesDirectory": { "type": "string" }
      }
    }
  },
  "$defs": {
    "contentType": {
      "type": "object",
      "required": ["id", "label", "fields"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": ["post", "page"]
        },
        "label": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": true,
          "description": "Default frontmatter on create"
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["key", "label", "dataType"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "description": "Frontmatter or config key"
        },
        "label": { "type": "string" },
        "dataType": {
          "type": "string",
          "enum": [
            "string",
            "markdown",
            "boolean",
            "datetime",
            "stringList",
            "select"
          ]
        },
        "required": { "type": "boolean", "default": false },
        "default": true,
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "description": "For select fields"
        },
        "editorWidget": {
          "type": "string",
          "description": "UI primitive hint (text, textarea, toggle, date, tags, select)"
        }
      }
    }
  }
}
